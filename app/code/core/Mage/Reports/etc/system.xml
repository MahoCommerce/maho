<config>
    <sections>
        <catalog>
            <groups>
                <recently_products translate="label" module="reports">
                    <label>Recently Viewed/Compared Products</label>
                    <sort_order>350</sort_order>
                    <show_in_default>1</show_in_default>
                    <show_in_website>1</show_in_website>
                    <show_in_store>0</show_in_store>
                    <fields>
                        <scope translate="label">
                            <label>Show for Current</label>
                            <frontend_type>select</frontend_type>
                            <source_model>adminhtml/system_config_source_reports_scope</source_model>
                            <sort_order>1</sort_order>
                            <show_in_default>1</show_in_default>
                            <show_in_website>1</show_in_website>
                            <show_in_store>0</show_in_store>
                        </scope>
                        <enabled_recently_viewed translate="label comment">
                            <label>Enable Recently Viewed Products</label>
                            <frontend_type>boolean</frontend_type>
                            <sort_order>10</sort_order>
                            <show_in_default>1</show_in_default>
                            <show_in_website>1</show_in_website>
                            <show_in_store>1</show_in_store>
                        </enabled_recently_viewed>
                        <viewed_count translate="label">
                            <label>Default Recently Viewed Products Count</label>
                            <sort_order>20</sort_order>
                            <show_in_default>1</show_in_default>
                            <show_in_website>1</show_in_website>
                            <show_in_store>1</show_in_store>
                            <frontend_class>validate-digits</frontend_class>
                        </viewed_count>
                        <enabled_product_compare translate="label comment">
                            <label>Enable Product Compare</label>
                            <frontend_type>boolean</frontend_type>
                            <sort_order>30</sort_order>
                            <show_in_default>1</show_in_default>
                            <show_in_website>1</show_in_website>
                            <show_in_store>1</show_in_store>
                        </enabled_product_compare>
                        <compared_count translate="label">
                            <label>Default Recently Compared Products Count</label>
                            <sort_order>40</sort_order>
                            <show_in_default>1</show_in_default>
                            <show_in_website>1</show_in_website>
                            <show_in_store>1</show_in_store>
                            <frontend_class>validate-digits</frontend_class>
                        </compared_count>
                    </fields>
                </recently_products>
            </groups>
        </catalog>
        <reports translate="label" module="reports">
            <label>Reports</label>
            <tab>general</tab>
            <sort_order>1000</sort_order>
            <show_in_default>1</show_in_default>
            <show_in_website>0</show_in_website>
            <show_in_store>0</show_in_store>
            <groups>
                <general translate="label">
                    <label>General</label>
                    <sort_order>1</sort_order>
                    <show_in_default>1</show_in_default>
                    <show_in_website>0</show_in_website>
                    <show_in_store>0</show_in_store>
                    <fields>
                        <enabled translate="label">
                            <label>Enable Reports</label>
                            <frontend_type>boolean</frontend_type>
                            <sort_order>1</sort_order>
                            <show_in_default>1</show_in_default>
                            <show_in_website>0</show_in_website>
                            <show_in_store>0</show_in_store>
                        </enabled>
                    </fields>
                </general>
                <dashboard translate="label">
                    <label>Dashboard</label>
                    <sort_order>2</sort_order>
                    <show_in_default>1</show_in_default>
                    <show_in_website>0</show_in_website>
                    <show_in_store>0</show_in_store>
                    <fields>
                        <ytd_start translate="label">
                            <label>Year-To-Date Starts</label>
                            <frontend_type>select</frontend_type>
                            <frontend_model>adminhtml/report_config_form_field_ytdStart</frontend_model>
                            <sort_order>1</sort_order>
                            <show_in_default>1</show_in_default>
                            <show_in_website>0</show_in_website>
                            <show_in_store>0</show_in_store>
                        </ytd_start>
                        <mtd_start translate="label comment">
                            <label>Current Month Starts</label>
                            <frontend_type>select</frontend_type>
                            <frontend_model>adminhtml/report_config_form_field_mtdStart</frontend_model>
                            <comment>Select day of the month.</comment>
                            <sort_order>2</sort_order>
                            <show_in_default>1</show_in_default>
                            <show_in_website>0</show_in_website>
                            <show_in_store>0</show_in_store>
                        </mtd_start>
                    </fields>
                </dashboard>
                <crontab translate="label">
                    <label>Cron Settings</label>
                    <sort_order>3</sort_order>
                    <show_in_default>1</show_in_default>
                    <show_in_website>0</show_in_website>
                    <show_in_store>0</show_in_store>
                    <fields>
                        <viewed_expr translate="label comment">
                            <label>Most Viewed</label>
                            <sort_order>800</sort_order>
                            <show_in_default>1</show_in_default>
                            <show_in_website>0</show_in_website>
                            <show_in_store>0</show_in_store>
                            <comment>Most Viewed Products Report</comment>
                        </viewed_expr>
                    </fields>
                </crontab>
                <not_found translate="label">
                    <label>404 Errors</label>
                    <sort_order>4</sort_order>
                    <show_in_default>1</show_in_default>
                    <show_in_website>0</show_in_website>
                    <show_in_store>0</show_in_store>
                    <fields>
                        <enabled translate="label comment">
                            <label>Record 404 Errors</label>
                            <frontend_type>boolean</frontend_type>
                            <sort_order>1</sort_order>
                            <show_in_default>1</show_in_default>
                            <show_in_website>0</show_in_website>
                            <show_in_store>0</show_in_store>
                            <comment>Count each storefront address that answers 404 in the 404 errors reports of Reports > Explorer.</comment>
                        </enabled>
                        <log_rate_limit translate="label comment">
                            <label>Pages Recorded per Hour per Visitor</label>
                            <validate>validate-digits</validate>
                            <sort_order>2</sort_order>
                            <show_in_default>1</show_in_default>
                            <show_in_website>0</show_in_website>
                            <show_in_store>0</show_in_store>
                            <comment>Above this number, the 404 page still shows, but the report does not count it. This stops a scanner from filling the report. Enter "0" for no limit.</comment>
                            <depends><enabled>1</enabled></depends>
                        </log_rate_limit>
                        <days_to_keep translate="label comment">
                            <label>Delete Addresses Not Seen For (days)</label>
                            <validate>validate-digits</validate>
                            <sort_order>3</sort_order>
                            <show_in_default>1</show_in_default>
                            <show_in_website>0</show_in_website>
                            <show_in_store>0</show_in_store>
                            <comment>Enter "0" to keep them.</comment>
                        </days_to_keep>
                        <max_rows translate="label comment">
                            <label>Maximum Addresses</label>
                            <validate>validate-digits</validate>
                            <sort_order>4</sort_order>
                            <show_in_default>1</show_in_default>
                            <show_in_website>0</show_in_website>
                            <show_in_store>0</show_in_store>
                            <comment>Every hour, the store deletes the addresses seen least recently above this number. Enter "0" for no limit.</comment>
                        </max_rows>
                    </fields>
                </not_found>
                <explorer translate="label">
                    <label>Explorer</label>
                    <sort_order>5</sort_order>
                    <show_in_default>1</show_in_default>
                    <show_in_website>0</show_in_website>
                    <show_in_store>0</show_in_store>
                    <fields>
                        <max_rows translate="label comment">
                            <label>Rows per Page</label>
                            <validate>validate-digits validate-greater-than-zero</validate>
                            <sort_order>1</sort_order>
                            <show_in_default>1</show_in_default>
                            <show_in_website>0</show_in_website>
                            <show_in_store>0</show_in_store>
                            <comment>The most rows that the Explorer page and the API show at once. A CSV export with more rows runs in the background.</comment>
                        </max_rows>
                        <export_max_rows translate="label comment">
                            <label>Rows per Export</label>
                            <validate>validate-digits validate-greater-than-zero</validate>
                            <sort_order>2</sort_order>
                            <show_in_default>1</show_in_default>
                            <show_in_website>0</show_in_website>
                            <show_in_store>0</show_in_store>
                            <comment>The most rows that one CSV export writes.</comment>
                        </export_max_rows>
                        <cache_lifetime_open translate="label comment">
                            <label>Cache Lifetime of a Current Period (seconds)</label>
                            <validate>validate-digits validate-greater-than-zero</validate>
                            <sort_order>3</sort_order>
                            <show_in_default>1</show_in_default>
                            <show_in_website>0</show_in_website>
                            <show_in_store>0</show_in_store>
                            <comment>A report whose period includes today, or a report on carts or stock, stays in the cache this long.</comment>
                        </cache_lifetime_open>
                        <cache_lifetime_closed translate="label comment">
                            <label>Cache Lifetime of a Past Period (seconds)</label>
                            <validate>validate-digits validate-greater-than-zero</validate>
                            <sort_order>4</sort_order>
                            <show_in_default>1</show_in_default>
                            <show_in_website>0</show_in_website>
                            <show_in_store>0</show_in_store>
                            <comment>A report on a period that ended before today stays in the cache this long. A save of this section clears the cache.</comment>
                        </cache_lifetime_closed>
                        <dead_stock_days translate="label comment">
                            <label>Dead Stock After (days)</label>
                            <validate>validate-digits validate-greater-than-zero</validate>
                            <sort_order>5</sort_order>
                            <show_in_default>1</show_in_default>
                            <show_in_website>0</show_in_website>
                            <show_in_store>0</show_in_store>
                            <comment>A product in stock with no sale in this number of days is dead stock.</comment>
                        </dead_stock_days>
                        <abandoned_after_hours translate="label comment">
                            <label>Abandoned After (hours)</label>
                            <validate>validate-digits validate-greater-than-zero</validate>
                            <sort_order>6</sort_order>
                            <show_in_default>1</show_in_default>
                            <show_in_website>0</show_in_website>
                            <show_in_store>0</show_in_store>
                            <comment>An active cart with an email and no order is abandoned after this number of hours without activity.</comment>
                        </abandoned_after_hours>
                        <recent_cart_hours translate="label comment">
                            <label>Recent Carts (hours)</label>
                            <validate>validate-digits validate-greater-than-zero</validate>
                            <sort_order>7</sort_order>
                            <show_in_default>1</show_in_default>
                            <show_in_website>0</show_in_website>
                            <show_in_store>0</show_in_store>
                            <comment>An active cart with no order is recent when its last activity is within this number of hours.</comment>
                        </recent_cart_hours>
                        <report_attributes translate="label comment">
                            <label>Attributes for Sales by Attribute</label>
                            <frontend_type>multiselect</frontend_type>
                            <source_model>reports/system_config_source_reportAttributes</source_model>
                            <can_be_empty>1</can_be_empty>
                            <sort_order>8</sort_order>
                            <show_in_default>1</show_in_default>
                            <show_in_website>0</show_in_website>
                            <show_in_store>0</show_in_store>
                            <comment>Each attribute gets a grouping and a report "Sales by" in the order items data.</comment>
                        </report_attributes>
                        <daily_totals_min_days translate="label comment">
                            <label>Daily Totals from (days)</label>
                            <validate>validate-digits</validate>
                            <sort_order>9</sort_order>
                            <show_in_default>1</show_in_default>
                            <show_in_website>0</show_in_website>
                            <show_in_store>0</show_in_store>
                            <comment>An order report on a period of at least this number of days reads the daily totals of the orders instead of each order, when its metrics, groupings and filters allow it. The numbers are the same, and a long period reads far fewer rows. "0" reads each order always. Enter a value, such as 7, when the reports of a store with many orders take seconds. Cron then builds the totals.</comment>
                        </daily_totals_min_days>
                        <email_hour translate="label comment">
                            <label>Hour of the Report Emails</label>
                            <validate>validate-digits validate-digits-range digits-range-0-23</validate>
                            <sort_order>10</sort_order>
                            <show_in_default>1</show_in_default>
                            <show_in_website>0</show_in_website>
                            <show_in_store>0</show_in_store>
                            <comment>The hour of the day, from 0 to 23 in the default time zone, when the store emails the saved reports. A weekly email goes on the first day of the week, and a monthly email on the first day of the month.</comment>
                        </email_hour>
                        <email_identity translate="label">
                            <label>Sender of the Report Emails</label>
                            <frontend_type>select</frontend_type>
                            <source_model>adminhtml/system_config_source_email_identity</source_model>
                            <sort_order>11</sort_order>
                            <show_in_default>1</show_in_default>
                            <show_in_website>0</show_in_website>
                            <show_in_store>0</show_in_store>
                        </email_identity>
                        <email_template translate="label">
                            <label>Template of the Report Emails</label>
                            <frontend_type>select</frontend_type>
                            <source_model>adminhtml/system_config_source_email_template</source_model>
                            <sort_order>12</sort_order>
                            <show_in_default>1</show_in_default>
                            <show_in_website>0</show_in_website>
                            <show_in_store>0</show_in_store>
                        </email_template>
                    </fields>
                </explorer>
            </groups>
        </reports>
        <system>
            <groups>
                <rate_limit>
                    <fields>
                        <reports_refresh translate="label comment" module="reports">
                            <label>Report statistics refresh</label>
                            <comment>Per admin user or API caller. Default 10 per minute. 0 to disable.</comment>
                            <sort_order>320</sort_order>
                            <show_in_default>1</show_in_default>
                            <show_in_website>0</show_in_website>
                            <show_in_store>0</show_in_store>
                            <validate>validate-digits validate-zero-or-greater</validate>
                        </reports_refresh>
                    </fields>
                </rate_limit>
            </groups>
        </system>
    </sections>
</config>
