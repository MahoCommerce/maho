<config>
    <sections>
        <catalog>
            <groups>
                <recently_products translate="label" module="reports">
                    <label>Recently Viewed/Compared Products</label>
                    <sort_order>350</sort_order>
                    <show_in_default>1</show_in_default>
                    <show_in_website>1</show_in_website>
                    <show_in_store>0</show_in_store>
                    <fields>
                        <scope translate="label">
                            <label>Show for Current</label>
                            <frontend_type>select</frontend_type>
                            <source_model>adminhtml/system_config_source_reports_scope</source_model>
                            <sort_order>1</sort_order>
                            <show_in_default>1</show_in_default>
                            <show_in_website>1</show_in_website>
                            <show_in_store>0</show_in_store>
                        </scope>
                        <enabled_recently_viewed translate="label comment">
                            <label>Enable Recently Viewed Products</label>
                            <frontend_type>boolean</frontend_type>
                            <sort_order>10</sort_order>
                            <show_in_default>1</show_in_default>
                            <show_in_website>1</show_in_website>
                            <show_in_store>1</show_in_store>
                        </enabled_recently_viewed>
                        <viewed_count translate="label">
                            <label>Default Recently Viewed Products Count</label>
                            <sort_order>20</sort_order>
                            <show_in_default>1</show_in_default>
                            <show_in_website>1</show_in_website>
                            <show_in_store>1</show_in_store>
                            <frontend_class>validate-digits</frontend_class>
                        </viewed_count>
                        <enabled_product_compare translate="label comment">
                            <label>Enable Product Compare</label>
                            <frontend_type>boolean</frontend_type>
                            <sort_order>30</sort_order>
                            <show_in_default>1</show_in_default>
                            <show_in_website>1</show_in_website>
                            <show_in_store>1</show_in_store>
                        </enabled_product_compare>
                        <compared_count translate="label">
                            <label>Default Recently Compared Products Count</label>
                            <sort_order>40</sort_order>
                            <show_in_default>1</show_in_default>
                            <show_in_website>1</show_in_website>
                            <show_in_store>1</show_in_store>
                            <frontend_class>validate-digits</frontend_class>
                        </compared_count>
                    </fields>
                </recently_products>
            </groups>
        </catalog>
        <reports translate="label" module="reports">
            <label>Reports</label>
            <tab>general</tab>
            <sort_order>1000</sort_order>
            <show_in_default>1</show_in_default>
            <show_in_website>0</show_in_website>
            <show_in_store>0</show_in_store>
            <groups>
                <general translate="label">
                    <label>General</label>
                    <sort_order>1</sort_order>
                    <show_in_default>1</show_in_default>
                    <show_in_website>0</show_in_website>
                    <show_in_store>0</show_in_store>
                    <fields>
                        <enabled translate="label">
                            <label>Enable Reports</label>
                            <frontend_type>boolean</frontend_type>
                            <sort_order>1</sort_order>
                            <show_in_default>1</show_in_default>
                            <show_in_website>0</show_in_website>
                            <show_in_store>0</show_in_store>
                        </enabled>
                    </fields>
                </general>
                <dashboard translate="label">
                    <label>Dashboard</label>
                    <sort_order>2</sort_order>
                    <show_in_default>1</show_in_default>
                    <show_in_website>0</show_in_website>
                    <show_in_store>0</show_in_store>
                    <fields>
                        <ytd_start translate="label">
                            <label>Year-To-Date Starts</label>
                            <frontend_type>select</frontend_type>
                            <frontend_model>adminhtml/report_config_form_field_ytdStart</frontend_model>
                            <sort_order>1</sort_order>
                            <show_in_default>1</show_in_default>
                            <show_in_website>0</show_in_website>
                            <show_in_store>0</show_in_store>
                        </ytd_start>
                        <mtd_start translate="label comment">
                            <label>Current Month Starts</label>
                            <frontend_type>select</frontend_type>
                            <frontend_model>adminhtml/report_config_form_field_mtdStart</frontend_model>
                            <comment>Select day of the month.</comment>
                            <sort_order>2</sort_order>
                            <show_in_default>1</show_in_default>
                            <show_in_website>0</show_in_website>
                            <show_in_store>0</show_in_store>
                        </mtd_start>
                    </fields>
                </dashboard>
                <crontab translate="label">
                    <label>Cron Settings</label>
                    <sort_order>3</sort_order>
                    <show_in_default>1</show_in_default>
                    <show_in_website>0</show_in_website>
                    <show_in_store>0</show_in_store>
                    <fields>
                        <viewed_expr translate="label comment">
                            <label>Most Viewed</label>
                            <sort_order>800</sort_order>
                            <show_in_default>1</show_in_default>
                            <show_in_website>0</show_in_website>
                            <show_in_store>0</show_in_store>
                            <comment>Most Viewed Products Report</comment>
                        </viewed_expr>
                    </fields>
                </crontab>
                <not_found translate="label">
                    <label>404 Errors</label>
                    <sort_order>4</sort_order>
                    <show_in_default>1</show_in_default>
                    <show_in_website>0</show_in_website>
                    <show_in_store>0</show_in_store>
                    <fields>
                        <enabled translate="label comment">
                            <label>Record 404 Errors</label>
                            <frontend_type>boolean</frontend_type>
                            <sort_order>1</sort_order>
                            <show_in_default>1</show_in_default>
                            <show_in_website>0</show_in_website>
                            <show_in_store>0</show_in_store>
                            <comment>Count each storefront address that answers 404 in Reports > 404 Errors.</comment>
                        </enabled>
                        <log_rate_limit translate="label comment">
                            <label>Pages Recorded per Hour per Visitor</label>
                            <validate>validate-digits</validate>
                            <sort_order>2</sort_order>
                            <show_in_default>1</show_in_default>
                            <show_in_website>0</show_in_website>
                            <show_in_store>0</show_in_store>
                            <comment>Above this number, the 404 page still shows, but the report does not count it. This stops a scanner from filling the report. Enter "0" for no limit.</comment>
                            <depends><enabled>1</enabled></depends>
                        </log_rate_limit>
                        <days_to_keep translate="label comment">
                            <label>Delete Addresses Not Seen For (days)</label>
                            <validate>validate-digits</validate>
                            <sort_order>3</sort_order>
                            <show_in_default>1</show_in_default>
                            <show_in_website>0</show_in_website>
                            <show_in_store>0</show_in_store>
                            <comment>Enter "0" to keep them.</comment>
                        </days_to_keep>
                        <max_rows translate="label comment">
                            <label>Maximum Addresses</label>
                            <validate>validate-digits</validate>
                            <sort_order>4</sort_order>
                            <show_in_default>1</show_in_default>
                            <show_in_website>0</show_in_website>
                            <show_in_store>0</show_in_store>
                            <comment>Every hour, the store deletes the addresses seen least recently above this number. Enter "0" for no limit.</comment>
                        </max_rows>
                    </fields>
                </not_found>
            </groups>
        </reports>
        <system>
            <groups>
                <rate_limit>
                    <fields>
                        <reports_refresh translate="label comment" module="reports">
                            <label>Report statistics refresh</label>
                            <comment>Per admin user or API caller. Default 10 per minute. 0 to disable.</comment>
                            <sort_order>320</sort_order>
                            <show_in_default>1</show_in_default>
                            <show_in_website>0</show_in_website>
                            <show_in_store>0</show_in_store>
                            <validate>validate-digits validate-zero-or-greater</validate>
                        </reports_refresh>
                    </fields>
                </rate_limit>
            </groups>
        </system>
    </sections>
</config>
