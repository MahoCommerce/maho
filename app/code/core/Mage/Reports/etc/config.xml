<config>
    <modules>
        <Mage_Reports>
            <version>2.0.0</version>
        </Mage_Reports>
    </modules>
    <global>
        <models>
            <reports>
                <class>Mage_Reports_Model</class>
                <resourceModel>reports_resource</resourceModel>
            </reports>
            <reports_resource>
                <class>Mage_Reports_Model_Resource</class>
                <entities>
                    <event>
                        <table>report_event</table>
                    </event>
                    <event_type>
                        <table>report_event_types</table>
                    </event_type>
                    <compared_product_index>
                        <table>report_compared_product_index</table>
                    </compared_product_index>
                    <viewed_product_index>
                        <table>report_viewed_product_index</table>
                    </viewed_product_index>
                    <viewed_aggregated_daily>
                        <table>report_viewed_product_aggregated_daily</table>
                    </viewed_aggregated_daily>
                    <viewed_aggregated_monthly>
                        <table>report_viewed_product_aggregated_monthly</table>
                    </viewed_aggregated_monthly>
                    <viewed_aggregated_yearly>
                        <table>report_viewed_product_aggregated_yearly</table>
                    </viewed_aggregated_yearly>
                    <viewed_aggregated_rolling>
                        <table>report_viewed_product_aggregated_rolling</table>
                    </viewed_aggregated_rolling>
                    <not_found>
                        <table>report_not_found</table>
                    </not_found>
                    <saved>
                        <table>report_saved</table>
                    </saved>
                    <dashboard_item>
                        <table>report_dashboard_item</table>
                    </dashboard_item>
                    <subscription>
                        <table>report_subscription</table>
                    </subscription>
                    <order_daily>
                        <table>report_order_daily</table>
                    </order_daily>
                    <order_daily_change>
                        <table>report_order_daily_change</table>
                    </order_daily_change>
                    <annotation>
                        <table>report_annotation</table>
                    </annotation>
                    <target>
                        <table>report_target</table>
                    </target>
                </entities>
            </reports_resource>
        </models>
        <services>
            <reports>
                <class>Mage_Reports_Service</class>
            </reports>
        </services>
        <queue>
            <routing>
                <reports>slow</reports>
            </routing>
        </queue>
        <resources>
            <report_read>
                <connection>
                    <use>core_read</use>
                </connection>
            </report_read>
        </resources>
        <cache>
            <types>
                <reports_explorer translate="label,description" module="reports">
                    <label>Report Explorer Results</label>
                    <description>The results of the report explorer, for a few minutes or, for a closed period, a day.</description>
                    <tags>REPORTS_EXPLORER</tags>
                </reports_explorer>
            </types>
        </cache>
        <storage>
            <mounts>
                <!-- Private: the report exports that the queue writes, with customer data -->
                <reports_exports>
                    <dir>var</dir>
                    <path>reports/export</path>
                </reports_exports>
            </mounts>
        </storage>
        <reports>
            <datasets>
                <carts>
                    <class>reports/report_dataset_carts</class>
                </carts>
                <cart_items>
                    <class>reports/report_dataset_cartItems</class>
                </cart_items>
                <product_views>
                    <class>reports/report_dataset_productViews</class>
                </product_views>
                <not_found>
                    <class>reports/report_dataset_notFound</class>
                </not_found>
            </datasets>
        </reports>
        <template>
            <email>
                <reports_explorer_email_template translate="label" module="reports">
                    <label>Saved Report by Email</label>
                    <file>reports_explorer_report.html</file>
                    <type>html</type>
                </reports_explorer_email_template>
            </email>
        </template>
        <docs>
            <user>docs/user</user>
            <developer>docs/developer</developer>
            <api>docs/api</api>
            <sysadmin>docs/sysadmin</sysadmin>
        </docs>
    </global>
    <adminhtml>
        <translate>
            <modules>
                <Mage_Reports>
                    <files>
                        <default>Mage_Reports.csv</default>
                    </files>
                </Mage_Reports>
            </modules>
        </translate>
    </adminhtml>
    <frontend>
        <translate>
            <modules>
                <Mage_Reports>
                    <files>
                        <default>Mage_Reports.csv</default>
                    </files>
                </Mage_Reports>
            </modules>
        </translate>
        <layout>
            <updates>
                <reports>
                    <file>reports.xml</file>
                </reports>
            </updates>
        </layout>
    </frontend>
    <default>
        <system>
            <rate_limit>
                <reports_refresh>10</reports_refresh>
            </rate_limit>
        </system>
        <catalog>
            <recently_products>
                <scope>website</scope>
                <enabled_recently_viewed>1</enabled_recently_viewed>
                <viewed_count>5</viewed_count>
                <enabled_product_compare>1</enabled_product_compare>
                <compared_count>5</compared_count>
            </recently_products>
        </catalog>
        <reports>
            <general>
                <enabled>1</enabled>
            </general>
            <dashboard>
                <ytd_start>1,1</ytd_start>
                <mtd_start>1</mtd_start>
            </dashboard>
            <crontab>
                <viewed_expr>0 0 * * *</viewed_expr>
            </crontab>
            <not_found>
                <enabled>1</enabled>
                <log_rate_limit>100</log_rate_limit>
                <days_to_keep>30</days_to_keep>
                <max_rows>10000</max_rows>
            </not_found>
            <explorer>
                <max_rows>10000</max_rows>
                <export_max_rows>1000000</export_max_rows>
                <cache_lifetime_open>300</cache_lifetime_open>
                <cache_lifetime_closed>86400</cache_lifetime_closed>
                <dead_stock_days>90</dead_stock_days>
                <abandoned_after_hours>24</abandoned_after_hours>
                <recent_cart_hours>24</recent_cart_hours>
                <report_attributes></report_attributes>
                <daily_totals_min_days>7</daily_totals_min_days>
                <email_hour>7</email_hour>
                <email_template>reports_explorer_email_template</email_template>
                <email_identity>general</email_identity>
            </explorer>
        </reports>
    </default>
</config>
