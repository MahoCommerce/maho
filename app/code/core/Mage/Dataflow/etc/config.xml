<config>
    <modules>
        <Mage_Dataflow>
            <version>2.0.0</version>
        </Mage_Dataflow>
    </modules>
    <global>
        <!-- The two directories that a profile file may sit in. See Mage_Dataflow_Model_Profile.
             Maho owns an export dir but no import dir, so only the second mount names var. -->
        <storage>
            <mounts>
                <exports>
                    <dir>export</dir>
                </exports>
                <imports>
                    <dir>var</dir>
                    <path>import</path>
                </imports>
            </mounts>
        </storage>
        <models>
            <dataflow>
                <class>Mage_Dataflow_Model</class>
                <resourceModel>dataflow_resource</resourceModel>
            </dataflow>
            <dataflow_resource>
                <class>Mage_Dataflow_Model_Resource</class>
                <entities>
                    <session>
                        <table>dataflow_session</table>
                    </session>
                    <import>
                        <table>dataflow_import_data</table>
                    </import>
                    <profile>
                        <table>dataflow_profile</table>
                    </profile>
                    <profile_history>
                        <table>dataflow_profile_history</table>
                    </profile_history>
                    <batch>
                        <table>dataflow_batch</table>
                    </batch>
                    <batch_export>
                        <table>dataflow_batch_export</table>
                    </batch_export>
                    <batch_import>
                        <table>dataflow_batch_import</table>
                    </batch_import>
                </entities>
            </dataflow_resource>
        </models>
    </global>
    <adminhtml>
        <layout>
            <updates>
                <dataflow>
                    <file>dataflow.xml</file>
                </dataflow>
            </updates>
        </layout>
    </adminhtml>
</config>
