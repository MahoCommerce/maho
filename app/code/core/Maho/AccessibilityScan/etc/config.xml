<config>
    <modules>
        <Maho_AccessibilityScan>
            <version>1.1.0</version>
        </Maho_AccessibilityScan>
    </modules>
    <global>
        <models>
            <accessibilityscan>
                <class>Maho_AccessibilityScan_Model</class>
                <resourceModel>accessibilityscan_resource</resourceModel>
            </accessibilityscan>
            <accessibilityscan_resource>
                <class>Maho_AccessibilityScan_Model_Resource</class>
                <entities>
                    <scan>
                        <table>accessibilityscan_scan</table>
                    </scan>
                    <page>
                        <table>accessibilityscan_page</table>
                    </page>
                    <violation>
                        <table>accessibilityscan_violation</table>
                    </violation>
                </entities>
            </accessibilityscan_resource>
        </models>
        <helpers>
            <accessibilityscan>
                <class>Maho_AccessibilityScan_Helper</class>
            </accessibilityscan>
        </helpers>
        <blocks>
            <accessibilityscan>
                <class>Maho_AccessibilityScan_Block</class>
            </accessibilityscan>
        </blocks>
        <resources>
            <accessibilityscan_setup>
                <setup>
                    <module>Maho_AccessibilityScan</module>
                    <class>Mage_Core_Model_Resource_Setup</class>
                </setup>
            </accessibilityscan_setup>
        </resources>
        <browser>
            <scanners>
                <accessibilityscan>accessibilityscan/runner</accessibilityscan>
            </scanners>
        </browser>
    </global>
    <adminhtml>
        <layout>
            <updates>
                <accessibilityscan>
                    <file>accessibilityscan.xml</file>
                </accessibilityscan>
            </updates>
        </layout>
    </adminhtml>
    <default>
        <accessibilityscan>
            <general>
                <wcag_level>AA</wcag_level>
                <timeout>60</timeout>
                <viewport_desktop>1280x1024</viewport_desktop>
                <viewport_mobile>390x844</viewport_mobile>
                <cleanup_days>90</cleanup_days>
            </general>
            <scheduled>
                <enabled>0</enabled>
                <schedule>0 3 * * *</schedule>
            </scheduled>
        </accessibilityscan>
    </default>
</config>
