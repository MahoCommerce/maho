<config>
    <sections>
        <accessibilityscan translate="label" module="accessibilityscan">
            <label>Accessibility Scan</label>
            <tab>advanced</tab>
            <frontend_type>text</frontend_type>
            <sort_order>200</sort_order>
            <show_in_default>1</show_in_default>
            <show_in_website>0</show_in_website>
            <show_in_store>0</show_in_store>
            <groups>
                <general translate="label">
                    <label>General Settings</label>
                    <frontend_type>text</frontend_type>
                    <sort_order>10</sort_order>
                    <show_in_default>1</show_in_default>
                    <show_in_website>0</show_in_website>
                    <show_in_store>0</show_in_store>
                    <fields>
                        <wcag_level translate="label comment">
                            <label>Default WCAG Level</label>
                            <frontend_type>select</frontend_type>
                            <source_model>accessibilityscan/source_wcagLevel</source_model>
                            <comment>Conformance level used when starting a scan without an explicit level.</comment>
                            <sort_order>10</sort_order>
                            <show_in_default>1</show_in_default>
                            <show_in_website>0</show_in_website>
                            <show_in_store>0</show_in_store>
                        </wcag_level>
                        <timeout translate="label comment">
                            <label>Scan Timeout</label>
                            <frontend_type>text</frontend_type>
                            <validate>validate-digits validate-greater-than-zero</validate>
                            <comment>Maximum time in seconds to wait for a single page scan.</comment>
                            <sort_order>20</sort_order>
                            <show_in_default>1</show_in_default>
                            <show_in_website>0</show_in_website>
                            <show_in_store>0</show_in_store>
                        </timeout>
                    </fields>
                </general>
                <advanced translate="label">
                    <label>Advanced</label>
                    <frontend_type>text</frontend_type>
                    <sort_order>20</sort_order>
                    <show_in_default>1</show_in_default>
                    <show_in_website>0</show_in_website>
                    <show_in_store>0</show_in_store>
                    <fields>
                        <node_path translate="label comment">
                            <label>Node.js Binary Path</label>
                            <frontend_type>text</frontend_type>
                            <comment>Path to the node executable. Default: node</comment>
                            <sort_order>10</sort_order>
                            <show_in_default>1</show_in_default>
                            <show_in_website>0</show_in_website>
                            <show_in_store>0</show_in_store>
                        </node_path>
                        <npm_path translate="label comment">
                            <label>npm Binary Path</label>
                            <frontend_type>text</frontend_type>
                            <comment>Path to the npm executable. Default: npm</comment>
                            <sort_order>20</sort_order>
                            <show_in_default>1</show_in_default>
                            <show_in_website>0</show_in_website>
                            <show_in_store>0</show_in_store>
                        </npm_path>
                    </fields>
                </advanced>
            </groups>
        </accessibilityscan>
    </sections>
</config>
