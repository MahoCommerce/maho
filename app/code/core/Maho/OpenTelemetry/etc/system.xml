<config>
    <sections>
        <dev translate="label" module="opentelemetry">
            <groups>
                <opentelemetry translate="label" module="opentelemetry">
                    <label>OpenTelemetry</label>
                    <mandatory_package>open-telemetry/exporter-otlp</mandatory_package>
                    <sort_order>200</sort_order>
                    <show_in_default>1</show_in_default>
                    <show_in_website>0</show_in_website>
                    <show_in_store>0</show_in_store>
                    <fields>
                        <enabled translate="label comment">
                            <label>Enable Tracing</label>
                            <frontend_type>select</frontend_type>
                            <source_model>adminhtml/system_config_source_yesno</source_model>
                            <sort_order>10</sort_order>
                            <show_in_default>1</show_in_default>
                            <show_in_website>0</show_in_website>
                            <show_in_store>0</show_in_store>
                            <comment><![CDATA[Enable OpenTelemetry distributed tracing.]]></comment>
                        </enabled>
                        <service_name translate="label comment">
                            <label>Service Name</label>
                            <frontend_type>text</frontend_type>
                            <sort_order>20</sort_order>
                            <show_in_default>1</show_in_default>
                            <show_in_website>0</show_in_website>
                            <show_in_store>0</show_in_store>
                            <comment><![CDATA[Identifier for this service in traces (e.g., "maho-production", "maho-staging").]]></comment>
                            <depends>
                                <enabled>1</enabled>
                            </depends>
                        </service_name>
                        <endpoint translate="label comment">
                            <label>OTLP Endpoint</label>
                            <frontend_type>text</frontend_type>
                            <sort_order>30</sort_order>
                            <show_in_default>1</show_in_default>
                            <show_in_website>0</show_in_website>
                            <show_in_store>0</show_in_store>
                            <comment><![CDATA[OTLP endpoint URL for trace exports (must end with <code>/v1/traces</code>). Example: <code>https://otlp-gateway-prod-eu-west-2.grafana.net/otlp/v1/traces</code>]]></comment>
                            <depends>
                                <enabled>1</enabled>
                            </depends>
                            <validate>required-entry validate-url</validate>
                        </endpoint>
                        <sampling_rate translate="label comment">
                            <label>Sampling Rate</label>
                            <frontend_type>text</frontend_type>
                            <sort_order>40</sort_order>
                            <show_in_default>1</show_in_default>
                            <show_in_website>0</show_in_website>
                            <show_in_store>0</show_in_store>
                            <comment><![CDATA[Percentage of requests to trace. Enter a value between 0.0 and 1.0 (1.0 = 100%, 0.1 = 10%, 0.01 = 1%). Lower values reduce data volume and costs.]]></comment>
                            <depends>
                                <enabled>1</enabled>
                            </depends>
                            <validate>required-entry validate-number validate-number-range number-range-0.0-1.0</validate>
                        </sampling_rate>
                        <environment translate="label comment">
                            <label>Deployment Environment</label>
                            <frontend_type>text</frontend_type>
                            <sort_order>45</sort_order>
                            <show_in_default>1</show_in_default>
                            <show_in_website>0</show_in_website>
                            <show_in_store>0</show_in_store>
                            <comment><![CDATA[Exported as the <code>deployment.environment.name</code> resource attribute, so one backend can hold several installs (e.g. <code>production</code>, <code>staging</code>). Leave empty to omit it.]]></comment>
                            <depends>
                                <enabled>1</enabled>
                            </depends>
                        </environment>
                        <auth_header translate="label comment">
                            <label>Authorization Header</label>
                            <frontend_type>obscure</frontend_type>
                            <backend_model>adminhtml/system_config_backend_encrypted</backend_model>
                            <sort_order>50</sort_order>
                            <show_in_default>1</show_in_default>
                            <show_in_website>0</show_in_website>
                            <show_in_store>0</show_in_store>
                            <comment><![CDATA[Authorization header value for authentication. For Grafana Cloud, use format: <code>Basic [base64(instance_id:api_token)]</code>. For other services, use their required format.]]></comment>
                            <depends>
                                <enabled>1</enabled>
                            </depends>
                        </auth_header>
                        <custom_headers translate="label comment">
                            <label>Custom Headers</label>
                            <frontend_type>textarea</frontend_type>
                            <sort_order>60</sort_order>
                            <show_in_default>1</show_in_default>
                            <show_in_website>0</show_in_website>
                            <show_in_store>0</show_in_store>
                            <comment><![CDATA[Additional HTTP headers in format <code>Key: Value</code> (one per line). Example:<br/><code>X-Custom-Header: value</code><br/><code>X-Another-Header: another-value</code><br/>Stored in plaintext: do not put credentials here, use the Authorization Header field for secrets.]]></comment>
                            <depends>
                                <enabled>1</enabled>
                            </depends>
                        </custom_headers>
                        <trace_blocks translate="label comment">
                            <label>Trace Block Rendering</label>
                            <frontend_type>select</frontend_type>
                            <source_model>adminhtml/system_config_source_yesno</source_model>
                            <sort_order>70</sort_order>
                            <show_in_default>1</show_in_default>
                            <show_in_website>0</show_in_website>
                            <show_in_store>0</show_in_store>
                            <comment><![CDATA[Create a span for every layout block rendered. Detailed but high volume: disable to keep traces small on complex pages.]]></comment>
                            <depends>
                                <enabled>1</enabled>
                            </depends>
                        </trace_blocks>
                        <trace_cache translate="label comment">
                            <label>Trace Cache Operations</label>
                            <frontend_type>select</frontend_type>
                            <source_model>adminhtml/system_config_source_yesno</source_model>
                            <sort_order>72</sort_order>
                            <show_in_default>1</show_in_default>
                            <show_in_website>0</show_in_website>
                            <show_in_store>0</show_in_store>
                            <comment><![CDATA[Create a span for every cache read, write and invalidation. The highest volume source of all, and the cache key is recorded as an attribute: enable it to debug a cache problem, not permanently.]]></comment>
                            <depends>
                                <enabled>1</enabled>
                            </depends>
                        </trace_cache>
                        <query_text translate="label comment">
                            <label>Query Statement</label>
                            <frontend_type>select</frontend_type>
                            <source_model>adminhtml/system_config_source_yesno</source_model>
                            <sort_order>74</sort_order>
                            <show_in_default>1</show_in_default>
                            <show_in_website>0</show_in_website>
                            <show_in_store>0</show_in_store>
                            <comment><![CDATA[Attach the SQL statement to every query span, so you can read the query that ran. Maho writes values into the statement rather than binding them, so the statement exports those values too, including customer data such as email addresses and password reset tokens. Turn this off if the OTLP backend must not hold customer data. Query names, timings and counts work either way.]]></comment>
                            <depends>
                                <enabled>1</enabled>
                            </depends>
                        </query_text>
                        <baggage_hosts translate="label comment">
                            <label>Baggage Hosts</label>
                            <frontend_type>textarea</frontend_type>
                            <sort_order>95</sort_order>
                            <show_in_default>1</show_in_default>
                            <show_in_website>0</show_in_website>
                            <show_in_store>0</show_in_store>
                            <comment><![CDATA[Hosts that may receive the W3C <code>baggage</code> header (store code and currency), one per line; a line also matches its subdomains. List your own services only. The <code>traceparent</code> header goes to every host either way: it carries two random ids and nothing else.]]></comment>
                            <depends>
                                <enabled>1</enabled>
                            </depends>
                        </baggage_hosts>
                        <excluded_paths translate="label comment">
                            <label>Excluded Paths</label>
                            <frontend_type>textarea</frontend_type>
                            <sort_order>80</sort_order>
                            <show_in_default>1</show_in_default>
                            <show_in_website>0</show_in_website>
                            <show_in_store>0</show_in_store>
                            <comment><![CDATA[Request paths that should never be traced, one per line. A line is a path prefix, or a wildcard pattern when it contains <code>*</code> or <code>?</code>. Example:<br/><code>/health</code><br/><code>/media/*</code>]]></comment>
                            <depends>
                                <enabled>1</enabled>
                            </depends>
                        </excluded_paths>
                        <trust_incoming_traces translate="label comment">
                            <label>Trust Incoming Trace Headers</label>
                            <frontend_type>select</frontend_type>
                            <source_model>adminhtml/system_config_source_yesno</source_model>
                            <sort_order>90</sort_order>
                            <show_in_default>1</show_in_default>
                            <show_in_website>0</show_in_website>
                            <show_in_store>0</show_in_store>
                            <comment><![CDATA[Continue traces started by callers that send W3C <code>traceparent</code> headers (distributed tracing). Enable only behind a trusted proxy or gateway: honoring arbitrary client trace ids can pollute sampling decisions.]]></comment>
                            <depends>
                                <enabled>1</enabled>
                            </depends>
                        </trust_incoming_traces>
                        <server_timing translate="label comment">
                            <label>Server-Timing Response Header</label>
                            <frontend_type>select</frontend_type>
                            <source_model>adminhtml/system_config_source_yesno</source_model>
                            <sort_order>100</sort_order>
                            <show_in_default>1</show_in_default>
                            <show_in_website>0</show_in_website>
                            <show_in_store>0</show_in_store>
                            <comment><![CDATA[Send the trace id to browsers in a <code>Server-Timing</code> header so real-user-monitoring tools (e.g. Grafana Faro) can link page loads to backend traces. The header exposes only the W3C trace context (trace id, span id and sampled flag), no other data.]]></comment>
                            <depends>
                                <enabled>1</enabled>
                            </depends>
                        </server_timing>
                        <export_logs translate="label comment">
                            <label>Export Logs</label>
                            <frontend_type>select</frontend_type>
                            <source_model>adminhtml/system_config_source_yesno</source_model>
                            <sort_order>110</sort_order>
                            <show_in_default>1</show_in_default>
                            <show_in_website>0</show_in_website>
                            <show_in_store>0</show_in_store>
                            <comment><![CDATA[Also send log records to the OTLP endpoint, correlated with traces. Requires the <code>open-telemetry/opentelemetry-logger-monolog</code> composer package. Log messages are exported as-is: treat the OTLP backend with the same sensitivity as the local <code>var/log</code> files.]]></comment>
                            <depends>
                                <enabled>1</enabled>
                            </depends>
                        </export_logs>
                        <export_metrics translate="label comment">
                            <label>Export Metrics</label>
                            <frontend_type>select</frontend_type>
                            <source_model>adminhtml/system_config_source_yesno</source_model>
                            <sort_order>120</sort_order>
                            <show_in_default>1</show_in_default>
                            <show_in_website>0</show_in_website>
                            <show_in_store>0</show_in_store>
                            <comment><![CDATA[Also send metrics to the OTLP endpoint: request duration histogram, orders, revenue and cart additions counters (delta temporality).]]></comment>
                            <depends>
                                <enabled>1</enabled>
                            </depends>
                        </export_metrics>
                    </fields>
                </opentelemetry>
            </groups>
        </dev>
    </sections>
</config>
