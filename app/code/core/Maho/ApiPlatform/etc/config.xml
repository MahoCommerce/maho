<config>
    <modules>
        <Maho_ApiPlatform>
            <version>1.0.1</version>
        </Maho_ApiPlatform>
    </modules>
    <global>
        <helpers>
            <apiplatform>
                <class>Maho_ApiPlatform_Helper</class>
            </apiplatform>
        </helpers>
        <models>
            <apiplatform>
                <class>Maho_ApiPlatform_Model</class>
                <resourceModel>apiplatform_resource</resourceModel>
            </apiplatform>
            <apiplatform_resource>
                <class>Maho_ApiPlatform_Model_Resource</class>
                <entities>
                    <user>
                        <table>api_user</table>
                    </user>
                    <role>
                        <table>api_role</table>
                    </role>
                    <rule>
                        <table>api_rule</table>
                    </rule>
                    <oauth_client>
                        <table>api_oauth_client</table>
                    </oauth_client>
                    <oauth_token>
                        <table>api_oauth_token</table>
                    </oauth_token>
                </entities>
            </apiplatform_resource>
        </models>
        <blocks>
            <apiplatform>
                <class>Maho_ApiPlatform_Block</class>
            </apiplatform>
        </blocks>
        <resources>
            <apiplatform_setup>
                <setup>
                    <module>Maho_ApiPlatform</module>
                </setup>
            </apiplatform_setup>
        </resources>
        <cache>
            <types>
                <api_data translate="label,description" module="apiplatform">
                    <label>API Data</label>
                    <description>REST and GraphQL API response cache (products, reviews, wishlists, etc.)</description>
                    <tags>API_PRODUCTS,API_REVIEWS,API_WISHLIST,API_STORE_CONFIG,API_COUNTRIES,API_DISCOVERY,API_LAYERED_FILTERS</tags>
                </api_data>
            </types>
        </cache>
    </global>
    <frontend>
        <translate>
            <modules>
                <Maho_ApiPlatform>
                    <files>
                        <default>Maho_ApiPlatform.csv</default>
                    </files>
                </Maho_ApiPlatform>
            </modules>
        </translate>
    </frontend>
    <adminhtml>
        <translate>
            <modules>
                <Maho_ApiPlatform>
                    <files>
                        <default>Maho_ApiPlatform.csv</default>
                    </files>
                </Maho_ApiPlatform>
            </modules>
        </translate>
        <layout>
            <updates>
                <apiplatform>
                    <file>apiplatform.xml</file>
                </apiplatform>
            </updates>
        </layout>
    </adminhtml>
    <default>
        <apiplatform>
            <protocols>
                <rest_v2>0</rest_v2>
                <graphql>0</graphql>
                <admin_graphql>0</admin_graphql>
                <mcp>0</mcp>
                <legacy_rest>0</legacy_rest>
                <soap>0</soap>
                <v2_soap>0</v2_soap>
                <xmlrpc>0</xmlrpc>
                <jsonrpc>0</jsonrpc>
            </protocols>
            <cache>
                <ttl>300</ttl>
            </cache>
            <oauth2>
                <token_lifetime>3600</token_lifetime>
                <refresh_token_lifetime>86400</refresh_token_lifetime>
                <!-- Off by default, like every protocol. Registration follows the
                     server, so turning the server on gives the connector flow that
                     needs it. -->
                <authorization_enabled>0</authorization_enabled>
                <dynamic_registration_enabled>1</dynamic_registration_enabled>
                <authorization_code_lifetime>60</authorization_code_lifetime>
                <mcp_require_auth>0</mcp_require_auth>
            </oauth2>
        </apiplatform>
    </default>
</config>
