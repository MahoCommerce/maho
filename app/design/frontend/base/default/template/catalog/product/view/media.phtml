/** @var Mage_Catalog_Block_Product_View_Media $this */
?>
<?php
$_product = $this->getProduct();
$mainImage = $this->helper('catalog/image')->init($_product, 'image');
$aspectRatio = $mainImage->getAspectRatio('gallery');
// The grid and the phone carousel show a swatch image in the cell of the main image
$_mainOrder = null;
$i = 0;
foreach ($this->getGalleryImages() as $_image) {
    if ($_mainOrder === null && $this->isGalleryImageVisible($_image) && $_image->getFile() === $_product->getImage()) {
        $_mainOrder = $i;
    }
    $i++;
}
?>
    <div class="product-image" role="region" aria-label="<?= $this->__('Product Images') ?>"
         data-gallery-layout="<?= $this->getGalleryLayout() ?>" data-gallery-phone="<?= $this->getGalleryPhoneLayout() ?>" style="--gallery-columns: <?= $this->getGalleryGridColumns() ?>">
        <div class="product-image-gallery" style="aspect-ratio: <?= $aspectRatio ?>; --gallery-ratio: <?= $aspectRatio ?><?= $_mainOrder === null ? '' : "; --gallery-main-order: {$_mainOrder}" ?>">
            <img id="image-main"
                class="gallery-image visible"
                <?= $mainImage->getImgAttributes('gallery') ?>
                alt="<?= $this->escapeHtml($this->getImageLabel()) ?>"
                title="<?= $this->escapeHtml($this->getImageLabel()) ?>"
                fetchpriority="high">

            <?php $i = 0;
            foreach ($this->getGalleryImages() as $_image): ?>
                <?php if ($this->isGalleryImageVisible($_image)): ?>
                    <?php
                        $galleryHelper = $this->helper('catalog/image')->init($_product, 'image', $_image->getFile());
                    ?>
                    <img id="image-<?= $i ?>"
                         class="gallery-image" loading="lazy" style="order: <?= $i ?>"<?= $i === $_mainOrder ? ' data-main' : '' ?>
                         <?= $galleryHelper->getImgAttributes('gallery') ?>
                         data-zoom-image="<?= $this->escapeUrl((string) $galleryHelper) ?>"
                         alt="<?= $this->escapeHtml($_image->getLabel() ?: $_product->getName() . ' - ' . $this->__('Image') . ' ' . ($i + 1)) ?>">
                <?php endif ?>
                <?php $i++; endforeach; ?>
        </div>
    </div>

<?php $_visibleImages = array_filter(iterator_to_array($this->getGalleryImages() ?? []), fn($_image) => $this->isGalleryImageVisible($_image)); ?>
<?php if (count($_visibleImages) > 1): ?>
    <div class="more-views" role="region" aria-label="<?= $this->__('Additional Views') ?>">
        <ul class="product-image-thumbs">
            <?php $i = 0;
            foreach ($this->getGalleryImages() as $_image): ?>
                <?php if ($this->isGalleryImageVisible($_image)): ?>
                    <li>
                        <a class="thumb-link" href="#" title="<?= $this->escapeHtml($_image->getLabel() ?: $_product->getName() . ' - ' . $this->__('Thumbnail') . ' ' . ($i + 1)) ?>" data-image-index="<?= $i ?>" role="button" aria-label="<?= $this->__('View image %s', $i + 1) ?>"<?= $_image->getFile() === $_product->getImage() ? ' aria-current="true"' : '' ?>>
                            <img <?= $this->helper('catalog/image')->init($this->getProduct(), 'image', $_image->getFile())->getImgAttributes('thumbnail') ?> alt="<?= $this->escapeHtml($_image->getLabel() ?: $_product->getName() . ' - ' . $this->__('Thumbnail') . ' ' . ($i + 1)) ?>">
                        </a>
                    </li>
                <?php endif ?>
                <?php $i++; endforeach; ?>
        </ul>
    </div>
<?php endif ?>

<?= $this->getChildHtml('after') ?>
