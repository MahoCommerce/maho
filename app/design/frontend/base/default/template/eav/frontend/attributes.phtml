/** @var Mage_Eav_Block_Frontend_Attributes $this */
?>
<?php foreach ($this->getAttributeGroups() as $_table): ?>
    <table class="data-table attribute-specs-table">
        <caption><?= $this->escapeHtml($_table['title']) ?></caption>
        <col width="25%">
        <col>
        <tbody>
        <?php foreach ($_table['rows'] as $_row): ?>
            <tr>
                <th class="label"><?= $this->escapeHtml($_row['label']) ?></th>
                <td class="data"><?= $this->getValueHtml($_row) ?></td>
            </tr>
        <?php endforeach ?>
        </tbody>
    </table>
<?php endforeach ?>
