/** @var Mage_Page_Block_Html_Breadcrumbs $this */
/** @var array|null $crumbs */
?>
<?php
// The trail shows the path, not the current position - every page announces
// itself with its own title. Drop the (unlinked) current-page leaf, and hide
// the whole trail when only "Home" would remain
if (is_array($crumbs) && $crumbs) {
    $lastKey = array_key_last($crumbs);
    if (empty($crumbs[$lastKey]['link'])) {
        unset($crumbs[$lastKey]);
    }
    if (count($crumbs) < 2) {
        $crumbs = [];
    }
}
?>
<?php if ($crumbs): ?>
<div class="breadcrumbs" role="navigation" aria-label="<?= $this->__('Breadcrumbs') ?>">
    <ul>
        <?php foreach ($crumbs as $_crumbName => $_crumbInfo): ?>
            <li class="<?= $_crumbName ?>">
            <?php if ($_crumbInfo['link']): ?>
                <a href="<?= $_crumbInfo['link'] ?>" title="<?= $this->escapeHtml($_crumbInfo['title']) ?>"><?= $this->escapeHtml($_crumbInfo['label']) ?></a>
            <?php elseif ($_crumbInfo['last']): ?>
                <strong><?= $this->escapeHtml($_crumbInfo['label']) ?></strong>
            <?php else: ?>
                <?= $this->escapeHtml($_crumbInfo['label']) ?>
            <?php endif ?>
            </li>
        <?php endforeach ?>
    </ul>
</div>
<?php endif ?>
