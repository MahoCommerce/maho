/** @var Maho_Giftcard_Block_Customer_Balance $this */
$_result = $this->getLastLookup();
?>
<div class="page-title">
    <h1><?= $this->__('Check Gift Card Balance') ?></h1>
</div>

<?= $this->getMessagesBlock()->getGroupedHtml() ?>

<div class="box-account box-giftcard-balance">
    <p class="form-instructions">
        <?= $this->__('Enter the code printed on your gift card to view the current balance and expiry date.') ?>
    </p>
    <form action="<?= $this->escapeUrl($this->getCheckUrl()) ?>" method="post" id="giftcard-balance-form" data-turbo="false">
        <?= $this->getBlockHtml('formkey') ?>
        <div class="coupon-input-group">
            <label for="giftcard_code" class="visually-hidden"><?= $this->__('Gift Card Code') ?></label>
            <input class="input-text coupon-input required-entry" type="text" id="giftcard_code" name="giftcard_code" value="" autocomplete="off" autofocus placeholder="<?= $this->__('Gift Card Code') ?>">
            <button type="submit" class="button btn-apply"><?= $this->__('Check Balance') ?></button>
        </div>
    </form>
</div>

<?php if ($_result !== null): ?>
    <div class="box-account box-giftcard-balance-result">
        <div class="box-head">
            <h2><?= $this->__('Balance for %s', $this->escapeHtml($_result['code'])) ?></h2>
        </div>
        <div class="box-content">
            <p class="giftcard-balance">
                <strong><?= $this->__('Current balance:') ?></strong>
                <span class="price"><?= $this->formatBalance($_result['balance'], $_result['currency_code']) ?></span>
            </p>
            <?php if (!empty($_result['expires_at'])): ?>
                <p class="giftcard-expires">
                    <strong><?= $this->__('Expires:') ?></strong>
                    <?= $this->formatDate($_result['expires_at'], Mage_Core_Model_Locale::FORMAT_TYPE_MEDIUM) ?>
                </p>
            <?php endif ?>
        </div>
    </div>
<?php endif ?>
