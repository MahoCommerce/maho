/**
 * The status badge of one privacy request. The parent passes the request as privacy_request.
 *
 * @var Mage_Core_Block_Template $this
 */
$request = $this->getData('privacy_request');
if (!$request instanceof Maho_PrivacyCenter_Model_Request) {
    return;
}
$class = match ($request->getStatus()) {
    Maho_PrivacyCenter_Model_Request::STATUS_PENDING => 'badge-warning',
    Maho_PrivacyCenter_Model_Request::STATUS_CONFIRMED, Maho_PrivacyCenter_Model_Request::STATUS_PROCESSING => 'badge-info',
    Maho_PrivacyCenter_Model_Request::STATUS_COMPLETED => 'badge-success',
    default => 'badge-neutral',
};
$label = Mage::getModel('privacycenter/source_status')->toOptionHash()[$request->getStatus()] ?? (string) $request->getStatus();
?>
<span class="badge badge-soft <?= $class ?>"><?= $this->escapeHtml($label) ?></span>
