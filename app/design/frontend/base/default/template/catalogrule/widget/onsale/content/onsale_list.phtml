/** @var Mage_CatalogRule_Block_Product_Widget_Onsale $this */
?>
<?php if (($_products = $this->getProductCollection()) && $_products->getSize()): ?>
<div class="widget widget-onsale">
    <div class="widget-title">
        <h2><?= $this->__('On Sale') ?></h2>
    </div>
    <div class="widget-products">
        <?= $this->getPagerHtml() ?>
        <ol class="mini-products-list">
        <?php $i = 0;
        foreach ($_products->getItems() as $_product): ?>
            <li class="item<?= (++$i == count($_products)) ? ' last' : '' ?>">
                <a href="<?= $_product->getProductUrl() ?>" title="<?= $this->stripTags($_product->getName(), null, true) ?>" class="product-image"><img <?= $this->helper('catalog/image')->init($_product, 'image')->getImgAttributes('thumbnail') ?> alt="<?= $this->stripTags($_product->getName(), null, true) ?>"></a>
                <div class="product-details">
                    <div class="f-fix">
                        <h3 class="product-name"><a href="<?= $_product->getProductUrl() ?>" title="<?= $this->stripTags($_product->getName(), null, true) ?>"><?= $this->helper('catalog/output')->productAttribute($_product, $_product->getName(), 'name') ?></a></h3>
                    </div>
                </div>
            </li>
        <?php endforeach ?>
        </ol>
    </div>
</div>
<?php endif ?>
