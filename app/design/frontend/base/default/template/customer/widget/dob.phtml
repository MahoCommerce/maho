/**
 * Usage, for example in checkout/onepage/billing.phtml:
 *
 * <?= $this->getLayout()->createBlock('customer/widget_dob')
 *    ->setDate($this->getCustomer()->getDob())
 *    ->setFieldIdFormat('billing:%s')
 *    ->setFieldNameFormat('billing[%s]')
 *    ->toHtml() ?>
 */

/** @var Mage_Customer_Block_Widget_Dob $this */
?>
<label for="<?= $this->getFieldId('dob') ?>"<?= $this->isRequired() ? ' class="required"' : '' ?>><?= $this->__('Date of Birth') ?></label>
<div class="input-box">
    <input type="date" id="<?= $this->getFieldId('dob') ?>" name="<?= $this->getFieldName('dob') ?>" value="<?= $this->escapeHtml($this->getIsoDate()) ?>" min="1900-01-01" max="<?= Mage_Core_Model_Locale::todayUtc() ?>" title="<?= $this->quoteEscape($this->__('Date of Birth')) ?>" class="input-text<?= $this->isRequired() ? ' required-entry' : '' ?>"<?= $this->isRequired() ? ' aria-required="true"' : '' ?> <?= $this->getFieldParams() ?>>
</div>
