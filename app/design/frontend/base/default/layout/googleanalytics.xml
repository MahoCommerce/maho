<layout version="0.1.0">

<!--
Default layout, loads most of the pages
-->

    <default>
        <!-- Mage_GoogleAnalytics -->
        <reference name="head" before="-">
            <block type="googleanalytics/gtm" name="google_tag_manager" as="google_tag_manager" template="googleanalytics/gtm.phtml" />
            <block type="googleanalytics/ga" name="google_analytics" as="google_analytics" template="googleanalytics/ga.phtml" />
            <block type="googleanalytics/metapixel" name="meta_pixel" as="meta_pixel" template="googleanalytics/metapixel.phtml" />
        </reference>
    </default>

    <!-- A preview of the content editor is not a visit -->
    <cms_preview_view>
        <remove name="google_tag_manager"/>
        <remove name="google_analytics"/>
        <remove name="meta_pixel"/>
    </cms_preview_view>
</layout>
