<theme>
    <parent />
    <!-- The widths of the resized images, and for each image entity its ratio (original, or
         such as 1:1 or 3:4) and its fit (contain adds a frame, cover crops). The slots give
         the sizes value of each place where images show, so the browser can pick the width;
         a template names the slot. A child theme inherits each value that it does not set. -->
    <images>
        <widths>150,300,600,1200,1800</widths>
        <slots>
            <thumbnail>100px</thumbnail>
            <small>180px</small>
            <listing>(min-width: 771px) 300px, 50vw</listing>
            <gallery>(min-width: 771px) 55vw, 100vw</gallery>
            <card>(min-width: 768px) 33vw, 100vw</card>
            <banner>(min-width: 1280px) 1200px, 100vw</banner>
            <email>300px</email>
        </slots>
        <product>
            <ratio>original</ratio>
        </product>
        <category>
            <ratio>original</ratio>
        </category>
        <blog>
            <ratio>original</ratio>
        </blog>
    </images>
</theme>
