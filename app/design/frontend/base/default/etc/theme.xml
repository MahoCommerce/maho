<theme>
    <parent />
    <!-- The widths of the resized images, and for each image entity its ratio (original, or
         such as 1:1 or 3:4) and its fit (contain adds a frame, cover crops). A child theme
         inherits each value that it does not set. -->
    <images>
        <widths>150,300,600,1200,1800</widths>
        <product>
            <ratio>original</ratio>
        </product>
        <category>
            <ratio>original</ratio>
        </category>
        <blog>
            <ratio>original</ratio>
        </blog>
    </images>
</theme>
