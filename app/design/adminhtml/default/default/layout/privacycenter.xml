<layout>
    <adminhtml_customer_privacy_index>
        <reference name="content">
            <block type="privacycenter/adminhtml_request" name="privacycenter_request"/>
        </reference>
    </adminhtml_customer_privacy_index>

    <adminhtml_customer_privacy_grid>
        <block type="core/text_list" name="root" output="toHtml">
            <block type="privacycenter/adminhtml_request_grid" name="privacycenter.request.grid"/>
        </block>
    </adminhtml_customer_privacy_grid>

    <adminhtml_customer_privacy_view>
        <reference name="content">
            <block type="privacycenter/adminhtml_request_view" name="privacycenter_request_view"/>
        </reference>
    </adminhtml_customer_privacy_view>

    <adminhtml_customer_edit>
        <reference name="customer_edit_tabs">
            <action method="addTab"><name>privacy</name><block>privacycenter/adminhtml_customer_edit_tab_privacy</block></action>
        </reference>
    </adminhtml_customer_edit>
</layout>
