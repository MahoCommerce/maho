/** @var Mage_Adminhtml_Block_Uploader_Multiple|Mage_Adminhtml_Block_Uploader_Single $this */
?>
<div id="<?= $this->getHtmlId() ?>" class="uploader">
<?php if ($this->getMiscConfig()->getAutoUpload()): ?>
    <button type="button" id="<?= $this->getElementId(Mage_Adminhtml_Block_Uploader_Abstract::DROP_ZONE_ID_SUFFIX) ?>" class="uploader-dropzone">
        <?= $this->getIconSvg('upload') ?>
        <span><?= $this->__('Drop files here, or click to choose them') ?></span>
    </button>
<?php else: ?>
    <div class="buttons a-right">
        <?= $this->getBrowseButtonHtml() ?>
        <?= $this->getUploadButtonHtml() ?>
    </div>
<?php endif ?>
</div>
<div class="no-display" id="<?= $this->getElementId('template') ?>">
    <div id="{{id}}-container" class="file-row">
        <span class="file-info">{{name}} {{size}}</span>
        <span class="delete-button"><?= $this->getDeleteButtonHtml() ?></span>
        <span class="progress-text"></span>
        <div class="clear"></div>
    </div>
</div>
<script type="module">
    const uploader = new Uploader(<?= $this->getJsonConfig() ?>);
    window.varienGlobalEvents?.attachEventHandler('tabChangeBefore', uploader.onContainerHideBefore);
</script>
<?= $this->getChildHtml('additional_scripts') ?>
