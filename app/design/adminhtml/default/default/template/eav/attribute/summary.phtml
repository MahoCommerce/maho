/** @var Mage_Core_Block_Template $this */
/** @var list<array{label: string, items: list<array{label: string, shown: bool}>, note: ?string}> $rows */
$rows = $this->getRows();
?>
<table class="form-list">
    <tbody>
        <?php foreach ($rows as $row): ?>
        <tr>
            <td class="label"><?= $this->escapeHtml($row['label']) ?></td>
            <td class="value">
                <div class="flex flex-wrap gap-1.5">
                    <?php foreach ($row['items'] as $item): ?>
                    <?php if ($item['shown']): ?>
                    <span class="d-badge d-badge-soft d-badge-success"><?= $this->escapeHtml($item['label']) ?></span>
                    <?php else: ?>
                    <span class="d-badge d-badge-ghost text-base-content/60 line-through"><?= $this->escapeHtml($item['label']) ?><span class="sr-only"> (<?= $this->escapeHtml(Mage::helper('eav')->__('Hidden')) ?>)</span></span>
                    <?php endif ?>
                    <?php endforeach ?>
                </div>
                <?php if ($row['note']): ?>
                <p class="note"><span><?= $this->escapeHtml($row['note']) ?></span></p>
                <?php endif ?>
            </td>
        </tr>
        <?php endforeach ?>
    </tbody>
</table>
