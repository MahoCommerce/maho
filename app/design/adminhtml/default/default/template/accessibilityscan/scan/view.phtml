 */

/**
 * @var Maho_AccessibilityScan_Block_Adminhtml_Scan_View $this
 */

$helper = Mage::helper('accessibilityscan');
$scan = $this->getScan();
$page = $this->getPage();
?>
<div class="content-header">
    <h3 class="icon-head"><?= $helper->__('Scan #%s', $scan->getId()) ?></h3>
    <p class="content-buttons form-buttons">
        <button type="button" class="scalable back" onclick="setLocation('<?= $this->escapeUrl($this->getBackUrl()) ?>')">
            <span><?= $helper->__('Back') ?></span>
        </button>
        <?php if ($scan->isComplete()): ?>
            <button type="button" class="scalable" onclick="setLocation('<?= $this->escapeUrl($this->getExportPdfUrl()) ?>')">
                <span><?= $helper->__('Export PDF') ?></span>
            </button>
        <?php endif; ?>
        <button type="button" class="scalable delete"
                onclick="accessibilityScanDelete('<?= $this->escapeUrl($this->getDeleteUrl()) ?>', '<?= $this->quoteEscape($helper->__('Are you sure you want to delete this scan?')) ?>')">
            <span><?= $helper->__('Delete') ?></span>
        </button>
    </p>
</div>

<?php if ($scan->isFailed()): ?>
    <div class="a11yscan-error">
        <strong><?= $helper->__('Scan failed') ?></strong>
        <p><?= $this->escapeHtml((string) $scan->getData('error_message')) ?></p>
    </div>
<?php endif; ?>

<table class="a11yscan-meta" cellspacing="0">
    <tr>
        <td><strong><?= $helper->__('URL') ?></strong></td>
        <td><a href="<?= $this->escapeUrl($scan->getUrl()) ?>" target="_blank" rel="noopener"><?= $this->escapeHtml($scan->getUrl()) ?></a></td>
    </tr>
    <?php if ($page && $page->getPageTitle()): ?>
        <tr>
            <td><strong><?= $helper->__('Page Title') ?></strong></td>
            <td><?= $this->escapeHtml($page->getPageTitle()) ?></td>
        </tr>
    <?php endif; ?>
    <tr>
        <td><strong><?= $helper->__('WCAG Level') ?></strong></td>
        <td><?= $this->escapeHtml($scan->getWcagLevel()) ?></td>
    </tr>
    <tr>
        <td><strong><?= $helper->__('Status') ?></strong></td>
        <td><span class="a11yscan-badge status-<?= $this->escapeHtml($scan->getStatus()) ?>"><?= $this->escapeHtml($scan->getStatus()) ?></span></td>
    </tr>
    <?php if ($scan->getData('completed_at')): ?>
        <tr>
            <td><strong><?= $helper->__('Completed') ?></strong></td>
            <td><?= $this->escapeHtml(Mage::helper('core')->formatDate($scan->getData('completed_at'), 'medium', true)) ?></td>
        </tr>
    <?php endif; ?>
</table>

<?php foreach ($this->getPages() as $screenshotPage): ?>
    <?php $screenshotUrl = $this->getScreenshotUrl($screenshotPage); ?>
    <?php if ($screenshotUrl): ?>
        <?php $screenshotLabel = $helper->__('%s Screenshot', $this->getViewportLabel($screenshotPage->getViewport())) ?>
        <details class="a11yscan-screenshot">
            <summary><?= $screenshotLabel ?></summary>
            <div class="a11yscan-screenshot-frame">
                <div class="a11yscan-screenshot-canvas">
                    <a href="<?= $this->escapeUrl($screenshotUrl) ?>" target="_blank" rel="noopener">
                        <img src="<?= $this->escapeUrl($screenshotUrl) ?>" alt="<?= $this->quoteEscape($screenshotLabel) ?>">
                    </a>
                    <?php foreach ($this->getScreenshotMarkers($screenshotPage) as $marker): ?>
                        <a id="a11yscan-marker-<?= $marker['id'] ?>"
                           class="a11yscan-marker <?= $this->escapeHtml($marker['impact']) ?>"
                           href="#violation-<?= $marker['id'] ?>"
                           style="left:<?= sprintf('%.3F', $marker['left']) ?>%;top:<?= sprintf('%.3F', $marker['top']) ?>%;width:<?= sprintf('%.3F', $marker['width']) ?>%;height:<?= sprintf('%.3F', $marker['height']) ?>%"
                           title="#<?= $marker['number'] ?> <?= $this->escapeHtml($marker['title']) ?>"
                           aria-label="<?= $this->quoteEscape($helper->__('Violation #%s: %s', $marker['number'], $marker['title'])) ?>"><span aria-hidden="true"><?= $marker['number'] ?></span></a>
                    <?php endforeach; ?>
                </div>
            </div>
        </details>
    <?php endif; ?>
<?php endforeach; ?>

<?php if ($scan->isComplete()): ?>
    <div class="a11yscan-cards">
        <div class="a11yscan-card">
            <span class="a11yscan-card-value"><?= $scan->getTotalViolations() ?></span>
            <span class="a11yscan-card-label"><?= $helper->__('Total Violations') ?></span>
        </div>
        <?php foreach ($scan->getViolationCounts() as $impact => $count): ?>
            <div class="a11yscan-card">
                <span class="a11yscan-card-value"><?= (int) $count ?></span>
                <span class="a11yscan-card-label"><span class="a11yscan-badge <?= $this->escapeHtml($impact) ?>"><?= $this->escapeHtml($impact) ?></span></span>
            </div>
        <?php endforeach; ?>
        <div class="a11yscan-card">
            <span class="a11yscan-card-value"><?= $scan->getIncompleteCount() ?></span>
            <span class="a11yscan-card-label"><?= $helper->__('Needs Review') ?></span>
        </div>
    </div>

    <?php if (!$scan->getTotalViolations()): ?>
        <p><?= $helper->__('No automatically detectable violations were found. Automated checks cover only part of WCAG, so manual testing with a keyboard and a screen reader is still recommended.') ?></p>
    <?php endif; ?>

    <?php if ($scan->getIncompleteCount()): ?>
        <p><?= $helper->__('axe-core could not automatically evaluate %s check(s) (for example, color contrast over an image). Review them manually.', $scan->getIncompleteCount()) ?></p>
    <?php endif; ?>

    <?php foreach ($this->getViolationsByImpact() as $impact => $violations): ?>
        <div class="a11yscan-group">
            <h4>
                <span class="a11yscan-badge <?= $this->escapeHtml($impact) ?>"><?= $this->escapeHtml($this->getImpactLabel($impact)) ?></span>
                <?= $helper->__('%s violation(s)', count($violations)) ?>
            </h4>
            <?php foreach ($violations as $violation): ?>
                <div class="a11yscan-violation <?= $this->escapeHtml($impact) ?>" id="violation-<?= (int) $violation->getId() ?>">
                    <div class="a11yscan-violation-head">
                        <span class="a11yscan-num">#<?= $this->getViolationNumber($violation) ?></span>
                        <code class="a11yscan-rule"><?= $this->escapeHtml($violation->getAxeRuleId()) ?></code>
                        <?php if ($violation->getWcagCriteria()): ?>
                            <span class="a11yscan-chip"><?= $helper->__('WCAG %s', $violation->getWcagCriteria()) ?></span>
                        <?php endif; ?>
                        <span class="a11yscan-chip"><?= $this->escapeHtml($this->getViewportLabel($this->getPageViewport($violation))) ?></span>
                        <?php if ($this->hasMarker($violation)): ?>
                            <a class="a11yscan-show-marker" href="#a11yscan-marker-<?= (int) $violation->getId() ?>"
                               onclick="accessibilityScanShowMarker(<?= (int) $violation->getId() ?>); return false;"><?= $helper->__('Show on screenshot') ?></a>
                        <?php endif; ?>
                    </div>
                    <p class="a11yscan-violation-desc">
                        <?= $this->escapeHtml((string) $violation->getDescription()) ?>
                        <?php if ($violation->getHelpUrl()): ?>
                            <a href="<?= $this->escapeUrl($violation->getHelpUrl()) ?>" target="_blank" rel="noopener"><?= $helper->__('Learn more') ?></a>
                        <?php endif; ?>
                    </p>
                    <?php if ($violation->getTemplateFile() || $violation->getCssSelector()): ?>
                        <div class="a11yscan-violation-meta">
                            <?php if ($violation->getTemplateFile()): ?>
                                <div>
                                    <span class="a11yscan-label"><?= $helper->__('Template') ?></span>
                                    <code><?= $this->escapeHtml($violation->getTemplateFile()) ?><?= $violation->getTemplateLine() ? ':' . (int) $violation->getTemplateLine() : '' ?></code>
                                </div>
                            <?php endif; ?>
                            <?php if ($violation->getCssSelector()): ?>
                                <div>
                                    <span class="a11yscan-label"><?= $helper->__('Selector') ?></span>
                                    <?php if ($this->hasMarker($violation)): ?>
                                        <a class="a11yscan-selector-link" href="#a11yscan-marker-<?= (int) $violation->getId() ?>"
                                           onclick="accessibilityScanShowMarker(<?= (int) $violation->getId() ?>); return false;"
                                           title="<?= $this->quoteEscape($helper->__('Show on screenshot')) ?>"><code><?= $this->escapeHtml($violation->getCssSelector()) ?></code></a>
                                    <?php else: ?>
                                        <code><?= $this->escapeHtml($violation->getCssSelector()) ?></code>
                                    <?php endif; ?>
                                </div>
                            <?php endif; ?>
                        </div>
                    <?php endif; ?>
                    <?php if ($violation->getHtmlSnippet()): ?>
                        <div class="a11yscan-violation-block">
                            <span class="a11yscan-label"><?= $helper->__('HTML') ?></span>
                            <pre><?= $this->escapeHtml($violation->getHtmlSnippet()) ?></pre>
                        </div>
                    <?php endif; ?>
                    <?php foreach ($this->getFailureSections($violation) as $section): ?>
                        <div class="a11yscan-violation-block">
                            <span class="a11yscan-label"><?= $this->escapeHtml($section['title']) ?></span>
                            <pre><?= $this->escapeHtml($section['body']) ?></pre>
                        </div>
                    <?php endforeach; ?>
                </div>
            <?php endforeach; ?>
        </div>
    <?php endforeach; ?>
<?php endif; ?>
