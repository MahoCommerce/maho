/**
 * @var Maho_AccessibilityScan_Block_Adminhtml_Scan_View $this
 */

$helper = Mage::helper('accessibilityscan');
$scan = $this->getScan();
$page = $this->getPage();
?>
<div class="content-header">
    <table cellspacing="0">
        <tr>
            <td><h3 class="icon-head"><?= $helper->__('Scan #%s', $scan->getId()) ?></h3></td>
            <td class="form-buttons">
                <button type="button" class="scalable back" onclick="setLocation('<?= $this->escapeUrl($this->getBackUrl()) ?>')">
                    <span><?= $helper->__('Back') ?></span>
                </button>
                <?php if ($scan->isComplete()): ?>
                    <button type="button" class="scalable" onclick="setLocation('<?= $this->escapeUrl($this->getExportPdfUrl()) ?>')">
                        <span><?= $helper->__('Export PDF') ?></span>
                    </button>
                <?php endif; ?>
                <button type="button" class="scalable delete"
                        onclick="accessibilityScanDelete('<?= $this->escapeUrl($this->getDeleteUrl()) ?>', '<?= $this->quoteEscape($helper->__('Are you sure you want to delete this scan?')) ?>')">
                    <span><?= $helper->__('Delete') ?></span>
                </button>
            </td>
        </tr>
    </table>
</div>

<?php if ($scan->isFailed()): ?>
    <div class="a11yscan-error">
        <strong><?= $helper->__('Scan failed') ?></strong>
        <p><?= $this->escapeHtml((string) $scan->getData('error_message')) ?></p>
    </div>
<?php endif; ?>

<table class="a11yscan-meta" cellspacing="0">
    <tr>
        <td><strong><?= $helper->__('URL') ?></strong></td>
        <td><a href="<?= $this->escapeUrl($scan->getUrl()) ?>" target="_blank" rel="noopener"><?= $this->escapeHtml($scan->getUrl()) ?></a></td>
    </tr>
    <?php if ($page && $page->getPageTitle()): ?>
        <tr>
            <td><strong><?= $helper->__('Page Title') ?></strong></td>
            <td><?= $this->escapeHtml($page->getPageTitle()) ?></td>
        </tr>
    <?php endif; ?>
    <tr>
        <td><strong><?= $helper->__('WCAG Level') ?></strong></td>
        <td><?= $this->escapeHtml($scan->getWcagLevel()) ?></td>
    </tr>
    <tr>
        <td><strong><?= $helper->__('Status') ?></strong></td>
        <td><span class="a11yscan-badge status-<?= $this->escapeHtml($scan->getStatus()) ?>"><?= $this->escapeHtml($scan->getStatus()) ?></span></td>
    </tr>
    <?php if ($scan->getData('completed_at')): ?>
        <tr>
            <td><strong><?= $helper->__('Completed') ?></strong></td>
            <td><?= $this->escapeHtml(Mage::helper('core')->formatDate($scan->getData('completed_at'), 'medium', true)) ?></td>
        </tr>
    <?php endif; ?>
</table>

<?php if ($scan->isComplete()): ?>
    <div class="a11yscan-cards">
        <div class="a11yscan-card">
            <span class="a11yscan-card-value"><?= $scan->getTotalViolations() ?></span>
            <span class="a11yscan-card-label"><?= $helper->__('Total Violations') ?></span>
        </div>
        <?php foreach ($scan->getViolationCounts() as $impact => $count): ?>
            <div class="a11yscan-card">
                <span class="a11yscan-card-value"><?= (int) $count ?></span>
                <span class="a11yscan-card-label"><span class="a11yscan-badge <?= $this->escapeHtml($impact) ?>"><?= $this->escapeHtml($impact) ?></span></span>
            </div>
        <?php endforeach; ?>
    </div>

    <?php if (!$scan->getTotalViolations()): ?>
        <p><?= $helper->__('No violations were found on this page. Well done!') ?></p>
    <?php endif; ?>

    <?php foreach ($this->getViolationsByImpact() as $impact => $violations): ?>
        <div class="a11yscan-group">
            <h4>
                <span class="a11yscan-badge <?= $this->escapeHtml($impact) ?>"><?= $this->escapeHtml($this->getImpactLabel($impact)) ?></span>
                <?= $helper->__('%s violation(s)', count($violations)) ?>
            </h4>
            <?php foreach ($violations as $violation): ?>
                <div class="a11yscan-violation <?= $this->escapeHtml($impact) ?>">
                    <h5>
                        <?= $this->escapeHtml($violation->getAxeRuleId()) ?>
                        <?php if ($violation->getWcagCriteria()): ?>
                            &mdash; <?= $helper->__('WCAG %s', $violation->getWcagCriteria()) ?>
                        <?php endif; ?>
                    </h5>
                    <p>
                        <?= $this->escapeHtml((string) $violation->getDescription()) ?>
                        <?php if ($violation->getHelpUrl()): ?>
                            <a href="<?= $this->escapeUrl($violation->getHelpUrl()) ?>" target="_blank" rel="noopener"><?= $helper->__('Learn more') ?></a>
                        <?php endif; ?>
                    </p>
                    <dl>
                        <?php if ($violation->getTemplateFile()): ?>
                            <dt><?= $helper->__('Template') ?></dt>
                            <dd><code><?= $this->escapeHtml($violation->getTemplateFile()) ?><?= $violation->getTemplateLine() ? ':' . (int) $violation->getTemplateLine() : '' ?></code></dd>
                        <?php endif; ?>
                        <?php if ($violation->getCssSelector()): ?>
                            <dt><?= $helper->__('Selector') ?></dt>
                            <dd><code><?= $this->escapeHtml($violation->getCssSelector()) ?></code></dd>
                        <?php endif; ?>
                        <?php if ($violation->getHtmlSnippet()): ?>
                            <dt><?= $helper->__('HTML') ?></dt>
                            <dd><pre><?= $this->escapeHtml($violation->getHtmlSnippet()) ?></pre></dd>
                        <?php endif; ?>
                        <?php if ($violation->getFailureSummary()): ?>
                            <dt><?= $helper->__('How to fix') ?></dt>
                            <dd><pre><?= $this->escapeHtml($violation->getFailureSummary()) ?></pre></dd>
                        <?php endif; ?>
                    </dl>
                </div>
            <?php endforeach; ?>
        </div>
    <?php endforeach; ?>
<?php endif; ?>
