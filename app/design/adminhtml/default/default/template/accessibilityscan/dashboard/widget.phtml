    margin-bottom: 2px;
    line-height: 1;
}
.a11yscan-widget-stats .stat-value.stat-failed {
    color: var(--maho-error);
}
.a11yscan-widget-stats .stat-label {
    color: var(--maho-ink-muted);
    font-size: 10px;
    text-transform: uppercase;
    letter-spacing: 0.3px;
    overflow-wrap: anywhere;
}
</style>
