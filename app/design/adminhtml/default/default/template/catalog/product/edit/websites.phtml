/** @var Mage_Adminhtml_Block_Catalog_Product_Edit_Tab_Websites $this */
?>
<div class="entry-edit">
    <div class="entry-edit-head">
        <h4><?= Mage::helper('catalog')->__('Product In Websites') ?></h4>
    </div>
    <fieldset id="grop_fields">
    <?php if ($this->getProductId()): ?>
        <ul class="messages">
            <li class="notice-msg">
                <ul>
                    <li><?= Mage::helper('catalog')->__("Items that you don't want to show in the catalog or search results should have status 'Disabled' in the desired store.") ?></li>
                </ul>
            </li>
        </ul>
    <?php endif ?>
    <ul class="product-websites">
        <?php foreach ($this->getWebsiteCollection() as $_website): ?>
            <li class="d-card d-card-border d-card-sm bg-base-100">
                <div class="d-card-body">
                <label class="d-card-title" for="product_website_<?= $_website->getId() ?>">
                    <input name="product[website_ids][]" value="<?= $_website->getId() ?>" <?php if ($this->isReadonly()): ?> disabled="disabled"<?php endif ?> class="checkbox website-checkbox" id="product_website_<?= $_website->getId() ?>" type="checkbox"<?php if ($this->hasWebsite($_website->getId())): ?> checked="checked"<?php endif ?>>
                    <?= $this->escapeHtml($_website->getName()) ?>
                </label>
                <div class="product-website-groups" id="product_website_<?= $_website->getId() ?>_data">
                    <?php foreach ($this->getGroupCollection($_website) as $_group): ?>
                        <div class="product-website-group">
                            <span class="product-website-group-name"><?= $this->escapeHtml($_group->getName()) ?></span>
                            <ul class="product-website-stores">
                                <?php foreach ($this->getStoreCollection($_group) as $_store): ?>
                                    <li>
                                        <span class="d-badge d-badge-sm"><?= $this->escapeHtml($_store->getName()) ?></span>
                                        <?php if ($this->getWebsites() && !$this->hasWebsite($_website->getId())): ?>
                                            <span class="website-<?= $_website->getId() ?>-select" style="display:none">
                                                <?= Mage::helper('catalog')->__('(Copy data from: %s)', $this->getChooseFromStoreHtml($_store)) ?>
                                            </span>
                                        <?php endif ?>
                                    </li>
                                <?php endforeach ?>
                            </ul>
                        </div>
                    <?php endforeach ?>
                </div>
                </div>
            </li>
        <?php endforeach ?>
    </ul>
    </fieldset>
</div>
<script>
    const productWebsiteCheckboxes = document.querySelectorAll('.website-checkbox');

    productWebsiteCheckboxes.forEach(checkbox => {
        checkbox.addEventListener('click', toggleStoreFromChoosers);
    });

    function toggleStoreFromChoosers(event) {
        const element = event.target;
        const dataContainer = document.getElementById(`product_website_${element.value}_data`);

        if (dataContainer) {
            const selects = dataContainer.querySelectorAll('select');
            const selectBlocks = dataContainer.querySelectorAll(`.website-${element.value}-select`);

            selects.forEach(select => {
                select.disabled = !element.checked;
            });

            selectBlocks.forEach(block => {
                block.style.display = element.checked ? '' : 'none';
            });
        }
    }
</script>
