/** @var Mage_Adminhtml_Block_Notification_Window $this */
?>
<?php if ($this->canShow()): ?>
<script>
    let messagePopupClosed = false;
    function openMessagePopup() {
        const height = document.documentElement.scrollHeight;
        const mask = document.getElementById('message-popup-window-mask');
        mask.style.height = `${height}px`;
        mask.style.display = 'block';
        document.getElementById('message-popup-window').classList.add('show');
    }

    function closeMessagePopup() {
        document.getElementById('message-popup-window-mask').style.display = 'none';
        document.getElementById('message-popup-window').classList.remove('show');
        messagePopupClosed = true;
    }

    window.addEventListener('load', openMessagePopup);
    window.addEventListener('keyup', (event) => {
        if (messagePopupClosed) return;
        if (event.key === 'Escape') {
            closeMessagePopup();
        }
    });
</script>
<div id="message-popup-window-mask" style="display:none;"></div>
<div id="message-popup-window" class="message-popup severity-<?= $this->getSeverityText() ?>" role="dialog" aria-modal="true" aria-labelledby="message-popup-title">
    <div class="message-popup-head">
        <h2 id="message-popup-title"><?= $this->getHeaderText() ?></h2>
        <button type="button" class="message-popup-close" onclick="closeMessagePopup()" title="<?= $this->getCloseText() ?>" aria-label="<?= $this->getCloseText() ?>">
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18 18 6M6 6l12 12" /></svg>
        </button>
    </div>
    <div class="message-popup-content">
        <span class="message-icon" aria-hidden="true">
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M12 9v3.75m9-.75a9 9 0 1 1-18 0 9 9 0 0 1 18 0Zm-9 3.75h.008v.008H12v-.008Z" /></svg>
        </span>
        <div class="message-body">
            <span class="message-severity"><?= $this->getSeverityLabel() ?></span>
            <p class="message-text"><?= $this->getNoticeMessageText() ?></p>
        </div>
    </div>
    <?php $url = (string) $this->getNoticeMessageUrl() ?>
    <?php if ($url !== ''): ?>
    <div class="message-popup-actions">
        <a class="message-popup-read" href="<?= $this->escapeUrl($url) ?>"<?php if (Mage::helper('adminnotification')->isExternalUrl($url)): ?> target="_blank" rel="noopener"<?php endif ?>><?= $this->getReadDetailsText() ?></a>
    </div>
    <?php endif ?>
</div>
<?php endif ?>
