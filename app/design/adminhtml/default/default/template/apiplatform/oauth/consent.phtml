/** @var Maho_ApiPlatform_Block_Adminhtml_Apiplatform_Oauth_Consent $this */

$errorMessage = $this->getErrorMessage();
?>
<!DOCTYPE html>
<html lang="<?= substr(Mage::app()->getLocale()->getLocaleCode(), 0, 2) ?>">
<head>
    <meta http-equiv="Content-Type" content="text/html; charset=utf-8">
    <meta name="robots" content="noindex, nofollow">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="theme-color" content="#121212">
    <title><?= $this->escapeHtml($this->__('Authorize Application')) ?></title>
    <link type="text/css" rel="stylesheet" href="<?= $this->getSkinUrl('login.css') ?>" media="all">
    <?= Mage::helper('page')->getFaviconHtml() ?>
</head>
<body id="page-login">
    <div class="login-container">
        <div class="login-box">
            <div class="login-form consent">
                <h2><?= $this->escapeHtml($this->__('Authorize Application')) ?></h2>

                <?php if ($errorMessage !== null): ?>
                    <div id="messages">
                        <ul>
                            <li><?= $this->escapeHtml($errorMessage) ?></li>
                        </ul>
                    </div>
                <?php else: ?>
                    <p class="consent-lead">
                        <?= $this->__('%s wants to connect to your store.', '<strong>' . $this->escapeHtml($this->getClientName()) . '</strong>') ?>
                    </p>

                    <?php if ($this->isUnverified()): ?>
                        <div id="messages">
                            <ul>
                                <li class="warning-msg"><?= $this->escapeHtml($this->__('This application registered itself and has not been verified. Approve it only if you started this connection yourself.')) ?></li>
                            </ul>
                        </div>
                    <?php endif ?>

                    <dl class="consent-details">
                        <dt><?= $this->escapeHtml($this->__('Your account')) ?></dt>
                        <dd><?= $this->escapeHtml($this->getAdminUsername()) ?></dd>
                        <dt><?= $this->escapeHtml($this->__('Sends you back to')) ?></dt>
                        <dd><code><?= $this->escapeHtml($this->getRedirectUri()) ?></code></dd>
                        <dt><?= $this->escapeHtml($this->__('Can reach')) ?></dt>
                        <dd><code><?= $this->escapeHtml($this->getResource()) ?></code></dd>
                    </dl>

                    <p class="consent-heading"><?= $this->escapeHtml($this->__('If you approve, this application can:')) ?></p>
                    <ul class="consent-grants">
                        <?php foreach ($this->getGrantSummary() as $line): ?>
                            <li><?= $this->escapeHtml($line) ?></li>
                        <?php endforeach ?>
                    </ul>

                    <form action="<?= $this->escapeUrl($this->getFormActionUrl()) ?>" method="post">
                        <input name="form_key" type="hidden" value="<?= $this->getFormKey() ?>">
                        <div class="form-buttons">
                            <button type="submit" name="decision" value="approve" class="form-button primary"><?= $this->escapeHtml($this->__('Approve')) ?></button>
                            <button type="submit" name="decision" value="deny" class="form-button"><?= $this->escapeHtml($this->__('Deny')) ?></button>
                        </div>
                    </form>
                <?php endif ?>
            </div>
        </div>
    </div>
</body>
</html>
