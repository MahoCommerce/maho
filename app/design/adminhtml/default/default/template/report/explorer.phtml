/** @var Mage_Adminhtml_Block_Report_Explorer $this */
?>
<div class="content-header">
    <h3 class="icon-head"><?= $this->escapeHtml($this->__('Explorer')) ?></h3>
</div>
<div id="report-explorer" class="report-explorer"
     data-config="<?= htmlspecialchars(Mage::helper('core')->jsonEncode($this->getConfig()), ENT_QUOTES, 'UTF-8') ?>">
    <p class="text-sm"><?= $this->escapeHtml($this->__('Loading…')) ?></p>
</div>
<script>
    document.addEventListener('DOMContentLoaded', () => {
        const element = document.getElementById('report-explorer');
        new MahoReportExplorer(element, JSON.parse(element.dataset.config));
    });
</script>
