/** @var Mage_Adminhtml_Block_System_Config_Tabs $this */
?>
<?php if ($this->getTitle()): ?>
    <h3><?= $this->getTitle() ?></h3>
<?php endif ?>
<?php if ($this->getTabs()): ?>
<div id="<?= $this->getId() ?>" class="config-tabs">
<?php foreach ($this->getTabs() as $_tab): ?>
    <?php if ($_tab->getSections()): ?>
    <ul class="d-menu<?php if ($_tab->getClass()): ?> <?= $_tab->getClass() ?><?php endif ?>">
        <li class="d-menu-title"><?= $_tab->getLabel() ?></li>
        <?php foreach ($_tab->getSections() as $_section): ?>
            <li>
                <a href="<?= $_section->getUrl() ?>" id="section-<?= $_section->getId() ?>" class="<?= $_section->getClass() ?><?php if ($_section->getId() == $this->getActiveSection()): ?> active<?php endif ?>"<?php if ($_section->getId() == $this->getActiveSection()): ?> aria-current="page"<?php endif ?>>
                    <?= $_section->getLabel() ?>
                </a>
            </li>
        <?php endforeach ?>
    </ul>
    <?php endif ?>
<?php endforeach ?>
</div>
<?php endif ?>
