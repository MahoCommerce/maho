/** @var Mage_Sales_Model_Order_Pdf_Items_Invoice_Grouped $this */
$item = $this->getItem();
$order = $this->getOrder();
?>

<td class="col-products">
    <div class="item-name"><?= $this->escapeHtml($this->getItemName()) ?></div>

    <?php if ($children = $this->getChildrenItems()): ?>
    <div class="grouped-children">
        <?php foreach ($children as $child): ?>
        <div class="child-item">
            <?= $this->escapeHtml($child->getName()) ?>
            (<?= $this->__('Qty') ?>: <?= $child->getQtyOrdered() * 1 ?>)
        </div>
        <?php endforeach ?>
    </div>
    <?php endif ?>

    <?php if ($options = $this->getItemOptions()): ?>
    <div class="item-options">
        <?php foreach ($options as $option): ?>
        <div class="option">
            <span class="option-label"><?= $this->escapeHtml($option['label']) ?>:</span>
            <span class="option-value"><?= $this->escapeHtml($option['value']) ?></span>
        </div>
        <?php endforeach ?>
    </div>
    <?php endif ?>
</td>

<td class="col-sku text-right">
    <?= $this->escapeHtml($this->getSku()) ?>
</td>

<td class="col-price text-right">
    <?php $prices = $this->getItemPricesForDisplay() ?>
    <?php foreach ($prices as $priceData): ?>
        <?php if (isset($priceData['label'])): ?>
        <div class="price-label"><?= $this->escapeHtml($priceData['label']) ?></div>
        <?php endif ?>
        <div class="price-value"><?= $priceData['price'] ?></div>
    <?php endforeach ?>
</td>

<td class="col-qty text-right">
    <?= $this->getItemQty() * 1 ?>
</td>

<td class="col-tax text-right">
    <?= $this->formatPrice($this->getItemTax()) ?>
</td>

<td class="col-subtotal text-right">
    <?php foreach ($prices as $priceData): ?>
        <?php if (isset($priceData['label'])): ?>
        <div class="subtotal-label"><?= $this->escapeHtml($priceData['label']) ?></div>
        <?php endif ?>
        <div class="subtotal-value"><?= $priceData['subtotal'] ?></div>
    <?php endforeach ?>
</td>
