# Credentials for the test suites that talk to real third-party services.
# Copy this file to .env.testing and fill in the ones you need.
# .env.testing is gitignored; CI provides these as secrets instead.
PAYPAL_SANDBOX_CLIENT_ID=
PAYPAL_SANDBOX_CLIENT_SECRET=

# Fixer API access key. Without it the live currency rate import tests skip.
FIXERIO_API_KEY=
