{
    "name": "maho-themes",
    "private": true,
    "scripts": {
        "build:theme": "tailwindcss -i public/skin/frontend/maho/default/src/tailwind.css -o public/skin/frontend/maho/default/css/styles.css --minify && tailwindcss -i public/skin/frontend/maho/default/src/blog.css -o public/skin/frontend/maho/default/css/blog.css --minify && tailwindcss -i public/skin/frontend/maho/default/src/onestep-checkout.css -o public/skin/frontend/maho/default/css/onestep-checkout.css --minify && tailwindcss -i public/skin/frontend/maho/default/src/checkout.css -o public/skin/frontend/maho/default/css/checkout.css --minify",
        "watch:theme": "tailwindcss -i public/skin/frontend/maho/default/src/tailwind.css -o public/skin/frontend/maho/default/css/styles.css --watch"
    },
    "dependencies": {
        "playwright": "^1.60.0"
    },
    "devDependencies": {
        "@tailwindcss/cli": "^4.3.2",
        "daisyui": "^5.6.7",
        "tailwindcss": "^4.3.2"
    }
}
