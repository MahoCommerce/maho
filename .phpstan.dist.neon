includes:
    - .phpstan.dist.baseline.neon
    - vendor/mahocommerce/maho-phpstan-plugin/extension.neon
    - vendor/phpstan/phpstan/conf/bleedingEdge.neon
    - vendor/phpstan/phpstan-deprecation-rules/rules.neon
    - vendor/phpstan/phpstan-strict-rules/rules.neon

parameters:
    strictRules:
        allRules: false
        matchingInheritedMethodNames: true
        disallowedBacktick: true

    level: 6
    tmpDir: .phpstan.cache
    reportUnmatchedIgnoredErrors: true
    checkFunctionNameCase: true
    checkInternalClassCaseSensitivity: true
    checkMissingOverrideMethodAttribute: true
    treatPhpDocTypesAsCertain: false
    reportMaybesInPropertyPhpDocTypes: true

    # Disable strict-rules parameters that aren't controlled by allRules
    reportMaybesInMethodSignatures: false
    fileExtensions:
        - php
        - phtml

    paths:
        - app
        - lib
        - maho
        - public

    ignoreErrors:
        - identifier: missingType.iterableValue
        # DBAL 4.5 marks AbstractNamedObject internal, but getObjectName() is the public NamedObject API.
        # Remove with doctrine/dbal#7520, or with DBAL 5.0, which drops the class (doctrine/dbal#7394).
        -
            identifier: method.internalClass
            message: '#^Call to method getObjectName\(\) of internal class Doctrine\\DBAL\\Schema\\Abstract(Optionally)?NamedObject<#'

services:
    -
        class: Tests\PHPStan\ServiceTypeExtension
        tags:
            - phpstan.broker.dynamicStaticMethodReturnTypeExtension
