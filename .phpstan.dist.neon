includes:
    - .phpstan.dist.baseline.neon
    - vendor/mahocommerce/maho-phpstan-plugin/extension.neon
    - vendor/phpstan/phpstan/conf/bleedingEdge.neon
    - vendor/phpstan/phpstan-deprecation-rules/rules.neon
    - vendor/phpstan/phpstan-strict-rules/rules.neon

parameters:
    strictRules:
        allRules: false
        booleansInLoopConditions: true
        closureUsesThis: true
        disallowedBacktick: true
        disallowedImplicitArrayCreation: true
        illegalConstructorMethodCall: true
        matchingInheritedMethodNames: true
        numericOperandsInArithmeticOperators: true
        overwriteVariablesWithLoop: true
        requireParentConstructorCall: true
        strictArrayFilter: true
        switchConditionsMatchingType: true

    level: 6
    tmpDir: .phpstan.cache
    reportUnmatchedIgnoredErrors: true
    checkMissingOverrideMethodAttribute: true
    treatPhpDocTypesAsCertain: false

    fileExtensions:
        - php
        - phtml

    paths:
        - app
        - lib
        - maho
        - public

    ignoreErrors:
        -
            identifier: missingType.iterableValue
            paths:
                - app/code/core/Mage/*
                - app/code/core/Maho/AdminActivityLog/*
                - app/code/core/Maho/Ai/*
                - app/code/core/Maho/ApiPlatform/*
                - app/code/core/Maho/Blog/*
                - app/code/core/Maho/CatalogLinkRule/*
                - app/code/core/Maho/ContentVersion/*
                - app/code/core/Maho/CustomerSegmentation/*
                - app/code/core/Maho/Giftcard/*
                - app/code/core/Maho/Intelligence/*
                - app/code/core/Maho/MediaCleaner/*
                - app/code/core/Maho/OpenTelemetry/*
                - app/code/core/Maho/Paypal/*
                - app/code/core/Maho/Revocation/*
                - app/code/core/Maho/ShippingBridge/*
                - app/code/core/Maho/SocialLogin/*
